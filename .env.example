# Medusa (backend v2.13+)
NEXT_PUBLIC_MEDUSA_BACKEND_URL="http://localhost:9000"
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=""

# State the cars are picked up from, as an ISO province code. A car rental is
# taxed where the car is handed over, and there is a single pickup location.
# Only used when the region's country is the US.
PICKUP_PROVINCE="fl"

# DEPRECATED -- being removed in P0-1. The tax rate now lives in Medusa as a
# tax rate and is applied by the rental pricing engine, so the storefront no
# longer holds a second copy of it. Left here until the checkout page stops
# reading it.
# NEXT_PUBLIC_TAX_RATE=0

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# Stripe: publishable key for storefront payment (Medusa checkout with Stripe)
# Get it from https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Public URL of the storefront, without a trailing slash. Used for canonical
# URLs, the sitemap, robots.txt and structured data, so in production it must
# be the real domain. Falls back to https://goldenexoticsclub.com when unset.
NEXT_PUBLIC_SITE_URL="https://goldenexoticsclub.com"
# Golden Exotics' own contact channels, shown on the confirmation page, city
# pages and cars that can't be booked online. A channel left empty is hidden
# (never a placeholder). WhatsApp with the country code: "+1 305 555 0100".
NEXT_PUBLIC_CONTACT_WHATSAPP=""
NEXT_PUBLIC_CONTACT_INSTAGRAM=""
NEXT_PUBLIC_CONTACT_EMAIL=""
